{
  "name": "kubelens",
  "version": "0.3.3",
  "license": "MIT",
  "description": "Browser-based Kubernetes visualization: WebGL resource graph + multi-window kubectl terminal, live or from offline snapshots",
  "keywords": [
    "kubernetes",
    "kubectl",
    "k8s",
    "dashboard",
    "visualization",
    "cli"
  ],
  "homepage": "https://github.com/jialinhuang00/kubelens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jialinhuang00/kubelens.git"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "kubelens": "./bin/kubelens.js"
  },
  "files": [
    "bin/",
    "api/",
    "scripts/",
    "shared/",
    "dist/kubelens/browser/",
    "kubelens.default.yaml",
    "README.md",
    "LICENSE",
    "!**/*.ts",
    "!scripts/README.md"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "concurrently \"tsx api/index.ts\" \"ng serve\"; stty sane",
    "build:export": "cd cmd/k8s-export && go build -o k8s-export .",
    "dev:go": "npm run build:export && concurrently \"PROJECT_ROOT=$PWD PORT=3042 go -C cmd/server run .\" \"ng serve\"",
    "build": "ng build",
    "build:server": "tsc -p tsconfig.publish.json",
    "init": "tsx scripts/init.ts",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:utils": "K8S_SNAPSHOT_PATH=/nonexistent-kubelens-test-snapshot tsx --test 'api/utils/**/*.spec.ts' 'api/routes/**/*.spec.ts'",
    "test:types": "tsc -p tsconfig.check.json",
    "test:parity": "tsx --test 'api/**/*.itest.ts'",
    "test:go": "go -C cmd/server test -count=1 ./...",
    "test:utils:cov": "K8S_SNAPSHOT_PATH=/nonexistent-kubelens-test-snapshot npx c8 --include='api/**/*.ts' --exclude='api/**/*.spec.ts' --exclude='api/**/*.itest.ts' --exclude='api/**/*.fixture.ts' --exclude='api/utils/test-fixtures.ts' tsx --test 'api/utils/**/*.spec.ts' 'api/routes/**/*.spec.ts'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "screenshot": "playwright test e2e/screenshots.spec.ts",
    "prepack": "npm run build:server",
    "prepublishOnly": "npm run build"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "js-yaml": "^4.1.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/build": "^22.2.3",
    "@angular/cdk": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/router": "^22.2.3",
    "@cosmograph/cosmos": "^1.6.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.2.3",
    "@types/ws": "^8.18.1",
    "concurrently": "^9.2.1",
    "jsdom": "^30.1.3",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.12",
    "tslib": "^2.3.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5",
    "zone.js": "~0.15.0"
  },
  "packageManager": "pnpm@10.32.1"
}
