{
  "name": "kubelens",
  "version": "0.2.0",
  "license": "MIT",
  "description": "Browser-based Kubernetes visualization: WebGL resource graph + multi-window kubectl terminal, live or from offline snapshots",
  "keywords": [
    "kubernetes",
    "kubectl",
    "k8s",
    "dashboard",
    "visualization",
    "cli"
  ],
  "homepage": "https://github.com/jialinhuang00/kubelens",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jialinhuang00/kubelens.git"
  },
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "kubelens": "./bin/kubelens.js"
  },
  "files": [
    "bin/",
    "api/",
    "scripts/",
    "shared/",
    "dist/kubelens/browser/",
    "kubelens.default.yaml",
    "README.md",
    "LICENSE",
    "!**/*.ts",
    "!scripts/README.md"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "dev": "concurrently \"tsx api/index.js\" \"ng serve\"; stty sane",
    "build:export": "cd cmd/k8s-export && go build -o k8s-export .",
    "dev:go": "npm run build:export && concurrently \"PROJECT_ROOT=$PWD PORT=3042 go -C cmd/server run .\" \"ng serve\"",
    "build": "ng build",
    "build:server": "tsc -p tsconfig.publish.json",
    "init": "tsx scripts/init.ts",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:utils": "K8S_SNAPSHOT_PATH=/nonexistent-kubelens-test-snapshot tsx --test api/utils/**/*.spec.ts api/routes/**/*.spec.ts",
    "test:go": "go -C cmd/server test ./...",
    "test:utils:cov": "K8S_SNAPSHOT_PATH=/nonexistent-kubelens-test-snapshot npx c8 --include='api/utils/*.ts' --exclude='api/utils/*.spec.ts' --exclude='api/utils/test-fixtures.ts' tsx --test 'api/utils/**/*.spec.ts'",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "screenshot": "playwright test e2e/screenshots.spec.ts",
    "prepack": "npm run build:server",
    "prepublishOnly": "npm run build"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "dependencies": {
    "@kubernetes/client-node": "^1.4.0",
    "dotenv": "^17.3.1",
    "express": "^5.1.0",
    "js-yaml": "^4.1.0",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@angular/animations": "^20.2.4",
    "@angular/build": "^20.2.2",
    "@angular/cdk": "^20.2.1",
    "@angular/cli": "^20.2.2",
    "@angular/common": "^20.2.4",
    "@angular/compiler": "^20.2.4",
    "@angular/compiler-cli": "^20.2.4",
    "@angular/core": "^20.2.4",
    "@angular/forms": "^20.2.4",
    "@angular/material": "^20.2.2",
    "@angular/platform-browser": "^20.2.4",
    "@angular/router": "^20.2.4",
    "@cosmograph/cosmos": "^1.6.1",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/jasmine": "~5.1.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.2.3",
    "concurrently": "^9.2.1",
    "jasmine-core": "~5.9.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "postcss": "^8.5.6",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.1.12",
    "tslib": "^2.3.0",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2",
    "zone.js": "~0.15.0"
  }
}
